{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "claude/redevelopment-platform-prototype-oodobu": true
    }
  },
  "functions": {
    "api/transcribe.js": { "maxDuration": 300 },
    "api/meeting-ai.js": { "maxDuration": 300 },
    "api/supplier-web-search.js": { "maxDuration": 300 },
    "api/tinypng-compress.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.redevelopment.pro" }],
      "destination": "https://redevelopment.pro/$1",
      "permanent": true
    },
    { "source": "/", "destination": "/minsk", "permanent": false },
    { "source": "/one", "destination": "/minsk/one", "permanent": true },
    { "source": "/redstorage", "destination": "/minsk/redstorage", "permanent": true },
    { "source": "/rayon-minsk-mir", "destination": "/minsk/minsk-mir", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/tz/(.*)", "destination": "/tz.html" },
    { "source": "/estimate/(.*)", "destination": "/estimate.html" },
    { "source": "/plan/(.*)", "destination": "/plan.html" },
    { "source": "/summary/(.*)", "destination": "/summary.html" },
    { "source": "/business-upload", "destination": "/business-upload.html" },
    { "source": "/admin/objects/(.*)", "destination": "/admin/objects/index.html" },
    { "source": "/admin/estimates/(.*)", "destination": "/admin/estimates/index.html" },
    { "source": "/admin/finmodels/(.*)", "destination": "/admin/finmodels/index.html" },
    { "source": "/admin/design-projects/(.*)", "destination": "/admin/design-projects/index.html" },
    { "source": "/admin/documents/(.*)", "destination": "/admin/documents/index.html" },
    { "source": "/admin/meeting-summaries/(.*)", "destination": "/admin/meeting-summaries/index.html" },
    { "source": "/admin/transactions/(.*)", "destination": "/admin/transactions/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
